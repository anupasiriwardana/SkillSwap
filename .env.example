# --- Database (Supabase) -------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> "Session pooler".
# Convert the URI to JDBC form: jdbc:postgresql://<host>:5432/postgres
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-database-password>

# --- Authentication -------------------------------------------------------
# Base64 string of at least 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=<generate-a-random-base64-secret>
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# --- First admin account (created on API start if it does not exist) ------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password>

# --- Ports used by docker compose -----------------------------------------
APP_PORT=3000
